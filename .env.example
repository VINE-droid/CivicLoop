# ── AI (Gemini) ────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=            # e.g. gemini-2.0-flash; verify in docs
GEMINI_EMBED_MODEL=      # e.g. text-embedding-004; verify in docs

# ── Supabase ───────────────────────────────────────────────
# NEXT_PUBLIC_* is safe to expose in the browser (URL only, NOT the service key)
NEXT_PUBLIC_SUPABASE_URL=
# Service role key must NEVER go to the client
SUPABASE_SERVICE_ROLE_KEY=

# ── Map defaults (Bengaluru) ───────────────────────────────
NEXT_PUBLIC_MAP_CENTER_LAT=12.9716
NEXT_PUBLIC_MAP_CENTER_LNG=77.5946

# ── Pipeline control ───────────────────────────────────────
# Set to true to skip Gemini and use rule-based fallback pipeline (demo safety net)
FORCE_FALLBACK=false
